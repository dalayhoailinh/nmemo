#!/usr/bin/env python3
"""Launcher: works from any folder, no install needed (python3 bin/nmemo <command>)."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from nmemo.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
